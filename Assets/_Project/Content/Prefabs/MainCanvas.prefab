      value: 1157.5
      objectReference: {fileID: 0}
    - target: {fileID: 2548757383125163981, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -510
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (1)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "The most common thing among us is dark, thick spots on the hands.\nThe
        skin there is rough like an old callus and darker than normal. I drew the
        spots of twelve relatives. I noticed: a son's spot has the same shape as
        his father's, a grandson's \u2014 as his grandfather's. And the more spots
        someone has, the worse the other deformities are.\nThis seems to be the first
        sign that something is wrong with the blood.\nQuestion: why do the spots
        appear first? Maybe the blood itself spoils starting here?"
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMin.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 132.5
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -510
