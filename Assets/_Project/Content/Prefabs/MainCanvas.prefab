      value: 1142.5
      objectReference: {fileID: 0}
    - target: {fileID: 2548757383125163981, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -510
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (7)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "I tried to find a substance that would stop our\u2026 I don't know
        what to call it. No longer a curse, but not a sickness either.\nI mixed into
        the flasks: alcohol, vinegar, salt, alum, even church incense. The results
        vary. In one flask the blood turned black and separated into layers. In another
        it bubbled and threw out thin threads like cobwebs.\nBut in the third\u2026
        I mixed the blood of an uncle and his niece with sulfuric acid. \nAfter three
        days, something living appeared on the surface. It pulsed and moved like
        an embryo. I smashed the flask and burned the contents.\nThis is not a curse.
        This is something ancient that lives in our blood and can be born by itself.
        I don't know what to do next. God save us."
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_fontSizeBase
      value: 40
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMin.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.x
