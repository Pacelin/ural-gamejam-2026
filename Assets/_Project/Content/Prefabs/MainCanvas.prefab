      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (2)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "Many in our kin have a torn face \u2014 from the lip to the nostril,
        and in some all the way to the roof of the mouth. They are born with it.\nI
        checked everyone living nearby from our family. If the father had a small
        crack, his son had a deeper one. If both parents had such cracks, their child
        had the worst torn face of all. With each generation, the tears grow larger.\nThis
        is not a random deformity \u2014 it passes on and gets worse."
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMin.y
