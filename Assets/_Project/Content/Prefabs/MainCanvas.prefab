    - target: {fileID: 2548757383125163981, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 1157.5
      objectReference: {fileID: 0}
    - target: {fileID: 2548757383125163981, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -510
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (3)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "Our skulls are breaking too.\nGreat-grandfather's was almost even.
        Grandfather's \u2014 left side higher than right. Father's \u2014 the back
        of the head is slanted. And I myself can feel bumps under my skin \u2014
        the bone grows inward and presses on the brain. Constant headaches, and some
        relatives lose consciousness.\nI measured skulls \u2014 with each generation
        the asymmetry gets stronger. Is this connected to the spots and the torn
        faces?\nI don't know yet, but it seems one corruption pulls another."
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_fontSizeBase
      value: 42
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMin.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 132.5
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -510
