    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (6)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "Let me write how I investigate.\nI take my blood, my father's, mother's,
        uncle's, cousin's. Pour it into large glass flasks and leave for several
        days \u2014 to watch the color change, whether sediment or films appear.\nI
        mix the blood of different relatives. Once I mixed the blood of a brother
        and a sister \u2014 strange clots appeared, resembling the threads I saw
        under the lens. \nNow I have a dozen flasks in my cellar. Each labeled with
        whose blood. Blood remembers ancestors \u2014 and their curse, if it is a
        curse."
      objectReference: {fileID: 0}
