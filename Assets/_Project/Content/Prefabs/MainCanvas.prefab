    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_Name
      value: P_ResearchPaperContent (5)
      objectReference: {fileID: 0}
    - target: {fileID: 5639303549511832841, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6044748545610405254, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_text
      value: "Now I am finally sure: this is not a curse. A curse acts randomly,
        but here \u2014 pure system.\nFirst spots, then torn faces, then crooked
        skulls, then squinting eyes, dull mind, short stature. Everything in strict
        order, and each generation is worse than the last.\nI can predict: if a child
        is born from two of our family, deformities are almost certain and heavier
        than in the parents. So it's not divine punishment, but something that works
        like clockwork.\nBut who wound this clock? And can it be stopped?"
      objectReference: {fileID: 0}
    - target: {fileID: 8668001385088751063, guid: 2c2cd871ca9df194b95a886e1cd05722, type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
