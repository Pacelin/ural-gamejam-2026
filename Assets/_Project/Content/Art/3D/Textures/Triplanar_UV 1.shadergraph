{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "51286fe46dba481f92cace38a3998e30",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TriplanarParallax (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -5175.19970703125,
            "y": 1126.39990234375,
            "width": 249.599609375,
            "height": 261.60009765625
        }
    },
    "m_Slots": [
        {
            "m_Id": "b8515799085f4834ac10f6c0c46b1479"
        },
        {
            "m_Id": "cd42b50c107847d39d331d946db60787"
        },
        {
            "m_Id": "a765b15146724b7bbe67ea3c0194781d"
        },
        {
            "m_Id": "10c2039075854316aa4c0d0eb363fb5c"
        },
        {
            "m_Id": "c51cb1e4fa9641cca6852725daea7697"
        },
        {
            "m_Id": "2a774787df11421dbd33132d7bc60a62"
        },
        {
            "m_Id": "dc9661d18b184b9aa09d7458869c7a71"
        },
        {
            "m_Id": "44efd22e56724604adc2b162391c7323"
        },
        {
            "m_Id": "596fca31bee246e39775e84f1caf8fc7"
        },
        {
            "m_Id": "f1fc89fd743b4472bb7e3339122be6e5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "TriplanarParallax",
    "m_FunctionSource": "68ba8608aac304d4ca85804b4dad3a89",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void TriplanarParallax_float(\r\n    float3 PositionWS,\r\n    float3 NormalWS,\r\n    float3 ViewDirWS,\r\n    Texture2D HeightMap,\r\n    SamplerState HeightSampler,\r\n    float HeightScale,\r\n    float HeightBias,\r\n    int NumSteps,\r\n    out float2 UV_X,\r\n    out float2 UV_Y,\r\n    out float2 UV_Z)\r\n{\r\n    // Исходные UV для каждой оси (мировые координаты)\r\n    float2 uvX_raw = PositionWS.zy;   // X-проекция: плоскость YZ\r\n    float2 uvY_raw = PositionWS.xz;   // Y-проекция: плоскость XZ\r\n    float2 uvZ_raw = PositionWS.xy;   // Z-проекция: плоскость XY\r\n\r\n    // Базисы касательного пространства для каждой проекции\r\n    // Ось X: нормаль = (1,0,0), касательная = (0,1,0), бинормаль = (0,0,1)\r\n    float3 tangentX = float3(0, 1, 0);\r\n    float3 bitangentX = float3(0, 0, 1);\r\n    float3 normalX = float3(1, 0, 0);\r\n\r\n    // Ось Y: нормаль = (0,1,0), касательная = (1,0,0), бинормаль = (0,0,1)\r\n    float3 tangentY = float3(1, 0, 0);\r\n    float3 bitangentY = float3(0, 0, 1);\r\n    float3 normalY = float3(0, 1, 0);\r\n\r\n    // Ось Z: нормаль = (0,0,1), касательная = (1,0,0), бинормаль = (0,1,0)\r\n    float3 tangentZ = float3(1, 0, 0);\r\n    float3 bitangentZ = float3(0, 1, 0);\r\n    float3 normalZ = float3(0, 0, 1);\r\n\r\n    // Функция для вычисления параллакс-смещения для одной проекции\r\n    // Возвращает смещённые UV\r\n    float2 ParallaxOffset(float2 uv, float3 viewDirWS, float3 tangent, float3 bitangent, float3 normalAxis)\r\n    {\r\n        // Вектор взгляда в касательном пространстве\r\n        float3 viewDirTS;\r\n        viewDirTS.x = dot(viewDirWS, tangent);\r\n        viewDirTS.y = dot(viewDirWS, bitangent);\r\n        viewDirTS.z = dot(viewDirWS, normalAxis);\r\n        viewDirTS = normalize(viewDirTS);\r\n\r\n        // Базовое смещение (один семпл высоты)\r\n        float height = HeightMap.SampleLevel(HeightSampler, uv, 0).r;\r\n        float offsetMagnitude = (height * HeightScale + HeightBias) / viewDirTS.z;\r\n        float2 offset = viewDirTS.xy * offsetMagnitude;\r\n\r\n        // Если требуется больше шагов (steep parallax), выполняем итерации\r\n        if (NumSteps > 1)\r\n        {\r\n            float stepSize = 1.0 / NumSteps;\r\n            float currentDepth = 0.0;\r\n            float2 deltaUV = viewDirTS.xy / (viewDirTS.z * NumSteps);\r\n            float2 uvStep = uv;\r\n\r\n            for (int i = 0; i < NumSteps; i++)\r\n            {\r\n                float stepHeight = HeightMap.SampleLevel(HeightSampler, uvStep, 0).r;\r\n                stepHeight = stepHeight * HeightScale + HeightBias;\r\n                if (currentDepth < stepHeight)\r\n                {\r\n                    offset = uvStep - uv;\r\n                    break;\r\n                }\r\n                uvStep += deltaUV;\r\n                currentDepth += stepSize;\r\n            }\r\n        }\r\n\r\n        return uv - offset;\r\n    }\r\n\r\n    // Вычисляем смещённые UV для каждой оси\r\n    UV_X = ParallaxOffset(uvX_raw, ViewDirWS, tangentX, bitangentX, normalX);\r\n    UV_Y = ParallaxOffset(uvY_raw, ViewDirWS, tangentY, bitangentY, normalY);\r\n    UV_Z = ParallaxOffset(uvZ_raw, ViewDirWS, tangentZ, bitangentZ, normalZ);\r\n}"
}

